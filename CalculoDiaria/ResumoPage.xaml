<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculoDiaria.ResumoPage"
             BackgroundColor="#F3F6FF"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout MaximumWidthRequest="700" HorizontalOptions="Center" Padding="20,32,20,32" Spacing="20">
            <Button Text="←  Voltar" Clicked="VoltarClicado" HorizontalOptions="Start" BackgroundColor="Transparent" TextColor="#5844D2" FontSize="15" Padding="0,8" />
            <VerticalStackLayout Spacing="7">
                <Label Text="Resumo da estadia" FontSize="30" FontAttributes="Bold" TextColor="#241F49" />
                <Label Text="Confira os detalhes da sua reserva." FontSize="14" TextColor="#777C99" />
            </VerticalStackLayout>
            <Border BackgroundColor="#5844D2" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="22">
                <VerticalStackLayout Spacing="12">
                    <Label Text="✦  SUA ACOMODAÇÃO" FontSize="12" CharacterSpacing="1.5" TextColor="#DAD4FF" FontAttributes="Bold" />
                    <Label x:Name="SuiteResumo" FontSize="27" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="DiariasResumo" FontSize="14" TextColor="#E5E0FF" />
                </VerticalStackLayout>
            </Border>
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Detalhes da hospedagem" FontSize="19" FontAttributes="Bold" TextColor="#241F49" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="15">
                        <Label Text="Adultos" Grid.Row="0" TextColor="#777C99" FontSize="15" />
                        <Label x:Name="AdultosResumo" Grid.Row="0" Grid.Column="1" TextColor="#241F49" FontAttributes="Bold" />
                        <Label Text="Crianças" Grid.Row="1" TextColor="#777C99" FontSize="15" />
                        <Label x:Name="CriancasResumo" Grid.Row="1" Grid.Column="1" TextColor="#241F49" FontAttributes="Bold" />
                        <Label Text="Check-in" Grid.Row="2" TextColor="#777C99" FontSize="15" />
                        <Label x:Name="EntradaResumo" Grid.Row="2" Grid.Column="1" TextColor="#241F49" FontAttributes="Bold" />
                        <Label Text="Check-out" Grid.Row="3" TextColor="#777C99" FontSize="15" />
                        <Label x:Name="SaidaResumo" Grid.Row="3" Grid.Column="1" TextColor="#241F49" FontAttributes="Bold" />
                        <Label Text="Valor da diária" Grid.Row="4" TextColor="#777C99" FontSize="15" />
                        <Label x:Name="ValorDiariaResumo" Grid.Row="4" Grid.Column="1" TextColor="#241F49" FontAttributes="Bold" />
                        <Label Text="Quantidade de diárias" Grid.Row="5" TextColor="#777C99" FontSize="15" />
                        <Label x:Name="QuantidadeResumo" Grid.Row="5" Grid.Column="1" TextColor="#241F49" FontAttributes="Bold" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E9EAF4" />
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Valor total" FontSize="15" TextColor="#777C99" />
                            <Label Text="Valor estimado da hospedagem" FontSize="12" TextColor="#9B9CB0" />
                        </VerticalStackLayout>
                        <Label x:Name="TotalResumo" Grid.Column="1" FontSize="25" FontAttributes="Bold" TextColor="#5844D2" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label Text="Esta é uma simulação de valores, sem taxas adicionais." FontSize="12" TextColor="#8589A5" HorizontalTextAlignment="Center" />
            <Button Text="Alterar reserva" Clicked="VoltarClicado" BackgroundColor="#5844D2" TextColor="White" FontSize="16" FontAttributes="Bold" HeightRequest="58" CornerRadius="16" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
